#!/usr/bin/env bash
set -Eeuo pipefail

resolved_self="$(readlink -f -- "${BASH_SOURCE[0]}")"
BW_REPO_ROOT="$(cd -- "$(dirname -- "$resolved_self")/.." && pwd -P)"
export BW_REPO_ROOT
# shellcheck source=../scripts/lib/common.sh
source "$BW_REPO_ROOT/scripts/lib/common.sh"

readonly BW_PHASES=(
  "00-preflight"
  "10-system"
  "20-packages"
  "25-host-theme"
  "30-shell"
  "40-dotfiles"
  "50-neovim"
  "60-codex"
  "70-github"
  "90-verify"
)

bw_usage() {
  cat <<'EOF'
Bloody Writer — one resumable terminal setup for Windows WSL and Termux on Android

Usage:
  ./install.sh [options]
  bloody-writer install [options]
  bloody-writer update [options]
  bloody-writer status
  bloody-writer platform
  bloody-writer doctor
  bloody-writer backup
  bloody-writer restore [BACKUP_DIRECTORY]
  bloody-writer remote
  bloody-writer reset-phase PHASE
  bloody-writer help

Install options:
  --yes                 Accept safe phase confirmations (not passwords or logins).
  --dry-run             Show the plan without changing files or installing packages.
  --force               Re-run phases that are already complete.
  --from PHASE          Resume from a chosen phase without clearing earlier state.
  --only PHASE          Run exactly one phase.
  --skip-host-theme     Defer the Windows Terminal or Termux visual host layer.
  --skip-github         Defer Git identity, GitHub login, and GitHub SSH-key setup.
  --skip-codex          Defer the local Codex phase on WSL.
  --skip-codex-login    Install Codex on WSL but defer its login flow.
  -h, --help            Show this guide.

Automatic platform behavior:
  Windows WSL 2   Full Arch Linux workstation, Windows Terminal theme, Codex.
  Termux on Android  Native Zsh/tmux/Neovim/Git/SSH; Codex is used remotely in WSL.

Pause and resume:
  If Windows Terminal must reopen, WSL must restart, or Android needs a permission/app,
  the installer records a checkpoint and stops safely. Complete the displayed action,
  return to this repository, and run ./install.sh again.

Phases:
  00-preflight  10-system      20-packages   25-host-theme  30-shell
  40-dotfiles   50-neovim      60-codex      70-github      90-verify

Examples:
  ./install.sh --dry-run
  ./install.sh --yes --skip-github
  ./install.sh --only 90-verify
EOF
}

bw_load_phases() {
  local phase
  for phase in "${BW_PHASES[@]}"; do
    # shellcheck source=/dev/null
    source "$BW_REPO_ROOT/scripts/phases/$phase.sh"
  done
}

bw_phase_function() {
  printf 'phase_%s\n' "${1//-/_}"
}

bw_install() {
  local from_phase=""
  local only_phase=""
  export BW_SKIP_GITHUB=0
  export BW_SKIP_HOST_THEME=0
  export BW_SKIP_CODEX=0
  export BW_SKIP_CODEX_LOGIN=0

  while (($#)); do
    case "$1" in
    --yes) BW_ASSUME_YES=1 ;;
    --dry-run) BW_DRY_RUN=1 ;;
    --force) BW_FORCE=1 ;;
    --skip-host-theme) BW_SKIP_HOST_THEME=1 ;;
    --skip-github) BW_SKIP_GITHUB=1 ;;
    --skip-codex) BW_SKIP_CODEX=1 ;;
    --skip-codex-login) BW_SKIP_CODEX_LOGIN=1 ;;
    --from)
      shift
      (($#)) || bw_die "--from requires a phase."
      from_phase="$1"
      ;;
    --only)
      shift
      (($#)) || bw_die "--only requires a phase."
      only_phase="$1"
      ;;
    -h | --help)
      bw_usage
      return 0
      ;;
    *) bw_die "Unknown install option: $1" ;;
    esac
    shift
  done
  export BW_ASSUME_YES BW_DRY_RUN BW_FORCE

  if [[ $BW_PLATFORM == unsupported && $BW_TEST_MODE != 1 ]]; then
    bw_die "Unsupported platform. Use Arch Linux on Windows WSL 2 or the Termux app on Android."
  fi

  if ((EUID == 0)) && [[ $BW_TEST_MODE != 1 && $BW_PLATFORM == wsl ]]; then
    [[ $BW_DRY_RUN != 1 ]] ||
      bw_die "The one-time root bootstrap cannot be previewed with --dry-run. Run it without options."
    exec "$BW_REPO_ROOT/scripts/bootstrap-root.sh"
  fi
  if ((EUID == 0)) && [[ $BW_TEST_MODE != 1 ]]; then
    bw_die "Run Bloody Writer as a normal user on $(bw_platform_label), not root."
  fi

  bw_ensure_dirs
  bw_banner
  bw_note "Detected: $(bw_platform_label)"
  bw_note "State: $BW_STATE_DIR"
  printf '\n'
  bw_load_phases

  local phase function started=0 found_only=0
  for phase in "${BW_PHASES[@]}"; do
    if [[ -n $only_phase && $phase != "$only_phase" ]]; then
      continue
    fi
    if [[ -n $only_phase && $phase == "$only_phase" ]]; then
      found_only=1
    fi
    if [[ -n $from_phase && $started == 0 ]]; then
      if [[ $phase == "$from_phase" ]]; then
        started=1
      else
        continue
      fi
    fi
    if [[ -z $from_phase ]]; then
      started=1
    fi

    if [[ $BW_FORCE != 1 ]] && bw_phase_done "$phase"; then
      bw_note "Skipping completed phase: $phase"
      continue
    fi
    if [[ $phase == 70-github && $BW_SKIP_GITHUB == 1 ]]; then
      bw_note "Leaving phase 70-github pending by request."
      continue
    fi
    if [[ $phase == 25-host-theme && $BW_SKIP_HOST_THEME == 1 ]]; then
      bw_note "Leaving phase 25-host-theme pending by request."
      continue
    fi
    if [[ $phase == 60-codex && $BW_SKIP_CODEX == 1 ]]; then
      bw_note "Leaving phase 60-codex pending by request."
      continue
    fi

    function="$(bw_phase_function "$phase")"
    declare -F "$function" >/dev/null || bw_die "Phase function is missing: $function"
    bw_log "Phase $phase"
    if "$function"; then
      bw_mark_phase "$phase"
    else
      local result=$?
      if ((result == 20)); then
        bw_warn "Installation paused at a manual checkpoint. Follow the instructions above, then run ./install.sh again."
        return 20
      fi
      return "$result"
    fi
  done

  [[ -z $only_phase || $found_only == 1 ]] || bw_die "Unknown phase: $only_phase"
  [[ -z $from_phase || $started == 1 ]] || bw_die "Unknown phase: $from_phase"

  if [[ -n ${BW_BACKUP_DIR:-} && $BW_DRY_RUN != 1 ]]; then
    bw_note "Pre-existing files were preserved in: $BW_BACKUP_DIR"
  fi
  if [[ $BW_DRY_RUN == 1 ]]; then
    bw_log "Preview complete; no state was changed."
  elif [[ -n $only_phase ]]; then
    if bw_phase_done "$only_phase"; then
      bw_log "Requested phase finished: $only_phase"
    else
      bw_warn "Requested phase remains pending: $only_phase"
    fi
  else
    local pending=0
    for phase in "${BW_PHASES[@]}"; do
      bw_phase_done "$phase" || pending=$((pending + 1))
    done
    if ((pending == 0)); then
      bw_log "Bloody Writer installation is complete."
      bw_note "Start the configured shell now with: exec zsh"
    else
      bw_warn "$pending phase(s) remain pending. Run 'bloody-writer status' for details."
    fi
  fi
}

bw_status() {
  bw_ensure_dirs
  printf 'Bloody Writer %s (%s)\n' "$BLOODY_WRITER_VERSION" "$(bw_repo_commit)"
  printf 'Platform: %s\n\n' "$(bw_platform_label)"
  local phase state
  for phase in "${BW_PHASES[@]}"; do
    state="pending"
    bw_phase_done "$phase" && state="complete"
    printf '%-16s %s\n' "$phase" "$state"
  done
  if [[ -f $BW_STATE_DIR/restart-required ]]; then
    printf '\nRestart required: %s\n' "$(cat "$BW_STATE_DIR/restart-required")"
  fi
  local checkpoint
  while IFS= read -r checkpoint; do
    printf 'Manual checkpoint: %s\n' "$(cat "$checkpoint")"
  done < <(find "$BW_STATE_DIR/manual" -maxdepth 1 -type f -print 2>/dev/null | LC_ALL=C sort)
}

bw_update() {
  local arguments=("$@")
  local argument
  while (($#)); do
    argument="$1"
    case "$argument" in
    --dry-run) BW_DRY_RUN=1 ;;
    --yes) BW_ASSUME_YES=1 ;;
    --force | --skip-host-theme | --skip-github | --skip-codex | --skip-codex-login) ;;
    --from | --only)
      shift
      (($#)) || bw_die "$argument requires a phase."
      ;;
    -h | --help)
      bw_usage
      return 0
      ;;
    *) bw_die "Unknown update option: $argument" ;;
    esac
    shift
  done
  export BW_DRY_RUN BW_ASSUME_YES
  bw_have git || bw_die "git is required."
  [[ -d $BW_REPO_ROOT/.git ]] || bw_die "Update requires a Git clone."
  if [[ -n $(git -C "$BW_REPO_ROOT" status --porcelain) ]]; then
    bw_die "The Bloody Writer checkout has local changes. Commit or stash them before updating."
  fi
  bw_log "Fetching a fast-forward-only update."
  bw_run git -C "$BW_REPO_ROOT" pull --ff-only
  local phase
  for phase in 20-packages 25-host-theme 30-shell 40-dotfiles 50-neovim 60-codex 90-verify; do
    bw_clear_phase "$phase"
  done
  bw_install "${arguments[@]}"
}

bw_backup() {
  bw_ensure_dirs
  local stamp archive
  stamp="$(date +%Y%m%d-%H%M%S-%N)"
  archive="$BW_STATE_DIR/backups/bloody-writer-$stamp.tar.gz"
  local paths=()
  local path
  for path in \
    "$HOME/.zshrc" \
    "$HOME/.tmux.conf" \
    "$HOME/.config/nvim" \
    "$HOME/.config/bloody-writer" \
    "$HOME/.local/bin/tma" \
    "$HOME/.local/bin/bw-clipboard-copy" \
    "$HOME/.local/bin/bloody-writer"; do
    [[ -e $path || -L $path ]] && paths+=("${path#"$HOME"/}")
  done
  ((${#paths[@]})) || bw_die "No Bloody Writer configuration is installed."
  bw_log "Creating configuration backup."
  bw_run tar -C "$HOME" -czhf "$archive" -- "${paths[@]}"
  bw_note "$archive"
}

bw_restore() {
  (($# <= 1)) || bw_die "restore accepts at most one backup directory."
  bw_ensure_dirs
  local backup_dir="${1:-}"
  if [[ -z $backup_dir ]]; then
    local candidate
    while IFS= read -r candidate; do
      if [[ ! -e $candidate/.restored ]]; then
        backup_dir="$candidate"
        break
      fi
    done < <(
      find "$BW_STATE_DIR/backups" -mindepth 1 -maxdepth 1 -type d -name '20*' |
        LC_ALL=C sort -r
    )
  fi
  [[ -n $backup_dir && -d $backup_dir ]] || bw_die "No installer backup directory was found."
  backup_dir="$(readlink -f -- "$backup_dir")"
  case "$backup_dir" in
  "$BW_STATE_DIR/backups"/*) ;;
  *) bw_die "Refusing to restore from outside $BW_STATE_DIR/backups." ;;
  esac
  [[ -s $backup_dir/manifest.tsv ]] || bw_die "Backup manifest is missing or empty: $backup_dir"
  [[ ! -e $backup_dir/.restored ]] || bw_die "This backup has already been restored: $backup_dir"

  local target saved relative displaced
  while IFS=$'\t' read -r target saved; do
    [[ -n $target && -n $saved ]] || continue
    bw_validate_home_target "$target"
    if [[ $saved != __MISSING__ ]]; then
      case "$saved" in
      "$backup_dir"/*) ;;
      *) bw_die "Backup manifest points outside its backup directory: $saved" ;;
      esac
      [[ -e $saved || -L $saved ]] || bw_die "Backup entry is missing: $saved"
    fi
  done <"$backup_dir/manifest.tsv"

  bw_warn "Restore will remove managed links and put the pre-install files back."
  bw_confirm "Restore from $backup_dir?" || return 0

  while IFS=$'\t' read -r target saved; do
    [[ -n $target && -n $saved ]] || continue
    bw_validate_home_target "$target"
    relative="${target#"$HOME"/}"

    if [[ -e $target || -L $target ]]; then
      if [[ -L $target ]] && [[ $(readlink -f -- "$target") == "$BW_REPO_ROOT"/* ]]; then
        rm -- "$target"
      else
        displaced="$backup_dir/pre-restore/$relative"
        mkdir -p "$(dirname -- "$displaced")"
        mv -- "$target" "$displaced"
      fi
    fi

    if [[ $saved != __MISSING__ ]]; then
      mkdir -p "$(dirname -- "$target")"
      mv -- "$saved" "$target"
    fi
  done <"$backup_dir/manifest.tsv"

  : >"$backup_dir/.restored"
  bw_clear_phase 40-dotfiles
  bw_clear_phase 90-verify
  bw_log "Pre-install configuration restored."
  bw_note "Any displaced post-install files are under: $backup_dir/pre-restore"
}

bw_reset_phase_command() {
  (($# == 1)) || bw_die "reset-phase requires exactly one phase."
  local requested="$1"
  local valid=0 phase
  for phase in "${BW_PHASES[@]}"; do
    [[ $phase == "$requested" ]] && valid=1
  done
  ((valid == 1)) || bw_die "Unknown phase: $requested"
  bw_clear_phase "$requested"
  bw_log "Reset phase $requested."
}

command_name="${1:-help}"
shift || true
case "$command_name" in
install) bw_install "$@" ;;
update) bw_update "$@" ;;
status) bw_status ;;
platform) bw_platform_label ;;
doctor) exec "$BW_REPO_ROOT/scripts/doctor.sh" "$@" ;;
backup) bw_backup ;;
restore) bw_restore "$@" ;;
remote) exec "$BW_REPO_ROOT/scripts/setup-remote.sh" "$@" ;;
reset-phase) bw_reset_phase_command "$@" ;;
help | -h | --help) bw_usage ;;
*) bw_die "Unknown command: $command_name" ;;
esac
